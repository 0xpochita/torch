# Contract accounts (defaults derive from NEAR_ROOT_ID=torchvault.testnet)
NEAR_COLLECTION_ID=nft.torchvault.testnet
NEAR_MARKET_ID=market.torchvault.testnet
NEAR_GACHA_ID=gacha.torchvault.testnet
# Comma-separated FT ids; default: the 14 mock tokens + wrap.testnet
# NEAR_FT_IDS=tusdc.torchvault.testnet,tbtc.torchvault.testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEARDATA_URL=https://testnet.neardata.xyz
# Backfill from this height on first start (otherwise starts at the tip); later starts resume from the cursor
# START_HEIGHT=
PORT=8787
# FIXTURE=1 replays synthetic blocks into memory, no network needed
# Price + NAV snapshot interval in ms (default 10 min)
# SNAPSHOT_MS=600000
