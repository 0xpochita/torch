# Wallet connect (@hot-labs/near-connect). All public.
# testnet: the picker lists wallets that support testnet (Meteor, Intear, Nightly, Ledger, ...).
# HOT Wallet is mainnet-only in the near-connect manifest; set mainnet to see it listed first.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com

# Indexer API (apps/api). Local: cd ../api && pnpm dev (or FIXTURE=1 pnpm dev for offline data)
NEXT_PUBLIC_API_URL=http://localhost:8787
