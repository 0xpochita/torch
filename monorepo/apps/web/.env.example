# Wallet connect (@hot-labs/near-connect). All public.
# testnet: the picker lists wallets that support testnet (Meteor, Intear, Nightly, Ledger, ...).
# HOT Wallet is mainnet-only in the near-connect manifest; set mainnet to see it listed first.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com
# Contract ids; scripts/deploy-testnet.sh writes these into .env.local
NEXT_PUBLIC_NEAR_ROOT_ID=torchvault.testnet
NEXT_PUBLIC_COLLECTION_ID=nft.torchvault.testnet
NEXT_PUBLIC_MARKET_ID=market.torchvault.testnet
NEXT_PUBLIC_GACHA_ID=gacha.torchvault.testnet
NEXT_PUBLIC_FT_IDS=tusdc.torchvault.testnet,tusdt.torchvault.testnet,tbtc.torchvault.testnet,teth.torchvault.testnet,thot.torchvault.testnet,trhea.torchvault.testnet,tlinear.torchvault.testnet,tstnear.torchvault.testnet,tzec.torchvault.testnet,taurora.torchvault.testnet,tnpro.torchvault.testnet,tdragon.torchvault.testnet,tshitzu.torchvault.testnet,tsweat.torchvault.testnet,wrap.testnet
# base58 sha256 of the vault wasm (global contract code hash), printed by the deploy script
NEXT_PUBLIC_VAULT_CODE_HASH=
